---
interface Props {
  name: 'arrow' | 'clock' | 'connect' | 'growth' | 'spark' | 'quote' | 'check';
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg
  class={className}
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'arrow' && <path d="M4 12h15m-6-6 6 6-6 6" />}
  {name === 'check' && <path d="m5 12 4 4L19 6" />}
  {name === 'quote' && (
    <>
      <rect x="5" y="3" width="14" height="18" rx="2" />
      <path d="M9 7h6M9 11h6M9 15h1m4 0h1m-6 3h1m4 0h1" />
    </>
  )}
  {name === 'clock' && (
    <>
      <circle cx="12" cy="12" r="8.5" />
      <path d="M12 7v5l3 2" />
    </>
  )}
  {name === 'connect' && (
    <>
      <rect x="2" y="3" width="7" height="7" rx="1" />
      <rect x="15" y="14" width="7" height="7" rx="1" />
      <path d="M9 6h5a4 4 0 0 1 4 4v4M6 10v4a4 4 0 0 0 4 4h5" />
    </>
  )}
  {name === 'growth' && (
    <>
      <path d="M4 18 11 11l4 4 6-9M15 6h6v6" />
      <path d="M4 5v13h16" />
    </>
  )}
  {name === 'spark' && (
    <path d="m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5L12 3Z" />
  )}
</svg>
