---
import BaseLayout from '../layouts/BaseLayout.astro';
import Brand from '../components/Brand.astro';
import ButtonLink from '../components/ButtonLink.astro';
---

<BaseLayout title="Page not found | Sidecar" noindex>
  <div class="error-page">
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <header class="site-header container">
      <Brand />
    </header>

    <main id="main" class="error-content container">
      <p class="eyebrow">
        <span class="accent-dot" /> 404 / Page not found
      </p>
      <h1>
        A little off track.
        <br />
        <span class="serif-emphasis">
          Let’s get you home<span class="accent-text">.</span>
        </span>
      </h1>
      <p class="error-description">
        This page may have moved, or the link might be incorrect. Head back to
        Sidecar and we’ll take it from there.
      </p>
      <ButtonLink href="/">Back to Sidecar</ButtonLink>
    </main>

    <footer class="error-footer container">
      <span>© {new Date().getFullYear()} Sidecar</span>
    </footer>
  </div>
</BaseLayout>

<style>
  .error-page {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }

  .error-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-block: clamp(64px, 12vh, 144px);
    text-align: center;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  h1 {
    max-width: 900px;
    font-size: clamp(44px, 6vw, 80px);
    line-height: 1.1;
  }

  .error-description {
    max-width: 440px;
    margin-block: 28px 32px;
    text-wrap: pretty;
  }

  .error-footer {
    padding-block: 28px;
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: 11px;
  }
</style>
